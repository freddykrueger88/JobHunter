# ─── Datenbank ───────────────────────────────────────────────────
# Passwort für PostgreSQL
DB_PASSWORD=changeme_secure_password

# ─── Backend ─────────────────────────────────────────────────────
# Langer zufälliger String für JWT-Signing etc.
# Generieren: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_very_long_random_secret_key_here

# Fernet-Key für Verschlüsselung von API-Keys in der DB
# Generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme_fernet_key_here

# ─── Ollama ───────────────────────────────────────────────────────
# Standard: interner Docker-Service. Nur ändern wenn Ollama extern läuft.
OLLAMA_BASE_URL=http://ollama:11434
